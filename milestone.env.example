# Copy file nay thanh .env o root repo truoc khi chay:
#   cp milestone.env.example .env
#   docker compose -f docker-compose.milestone.yml up -d --build

# Public URL cua website (de sinh link dung domain thay vi localhost)
PUBLIC_BASE_URL=https://your-domain.com

# Bridge key dung chung giua LTW251 va OpenClaw
WEB_BRIDGE_API_KEY=change-me-strong-random-key

# Messenger webhook
MESSENGER_VERIFY_TOKEN=change-me-messenger-verify-token
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_GRAPH_VERSION=v21.0

# Telegram mini app (optional)
TELEGRAM_MINI_APP_URL=
EXTERNAL_SESSION_SECRET=change-me-shared-signing-secret
EXTERNAL_SESSION_TTL_SEC=86400

# Dialogue engine v2 rollout
DIALOG_ENGINE_V2_ENABLED=false
DIALOG_SESSION_TTL_HOURS=24
DIALOG_HYBRID_ASSIST_ENABLED=true
DIALOG_HYBRID_ASSIST_THRESHOLD=0.55
OPENCLAW_CHAT_RATE_LIMIT_WINDOW_SEC=30
OPENCLAW_CHAT_RATE_LIMIT_MAX=30
MESSENGER_WEBHOOK_RATE_LIMIT_MAX=20
MESSENGER_WEBHOOK_RATE_LIMIT_WINDOW_SEC=10

# SRE alert notify (optional)
ALERT_NOTIFY_MODE=fail_only
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
