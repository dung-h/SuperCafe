# Copy file này thành infra/env/.env trước khi chạy

# Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME_ROTATED_TOKEN
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_GATEWAY_HOST=0.0.0.0
TELEGRAM_GATEWAY_PORT=8083
# URL cong khai HTTPS de Telegram mo Mini App (vi du https://miniapp.your-domain.com)
# Neu chua public mini app thi de rong.
TELEGRAM_MINI_APP_URL=
TELEGRAM_WEB_SESSION_SECRET=change-me-shared-signing-secret
TELEGRAM_WEB_SESSION_TTL_SEC=86400
TELEGRAM_MINIAPP_HOST=0.0.0.0
TELEGRAM_MINIAPP_PORT=8084

# Admin
ADMIN_WHITELIST_IDS=123456789,987654321
# Tao hash argon2id bang lenh trong docs/runbook.md
ADMIN_PASSPHRASE_HASH=REPLACE_ARGON2ID_HASH
# Dev fallback cho local demo neu hash bi loi noi suy '$'
ADMIN_PASSPHRASE_PLAIN=
ADMIN_ALERT_CHAT_ID=-1001234567890
ADMIN_SESSION_TTL_MIN=480

# sales-mcp
SALES_MCP_HOST=0.0.0.0
SALES_MCP_PORT=8081
SQLITE_PATH=/data/sales.db
DEFAULT_SHIPPING_VND=30000
SALES_MCP_API_KEY=change_this_internal_api_key

# openclaw
OPENCLAW_HOST=0.0.0.0
OPENCLAW_PORT=8082
OPENCLAW_TIMEOUT_MS=20000
DIALOG_ENGINE_V2_ENABLED=false
DIALOG_SESSION_TTL_HOURS=24
DIALOG_HYBRID_ASSIST_ENABLED=true
DIALOG_HYBRID_ASSIST_THRESHOLD=0.55
OPENCLAW_CHAT_RATE_LIMIT_WINDOW_SEC=30
OPENCLAW_CHAT_RATE_LIMIT_MAX=30
OPENCLAW_DB_HOST=lowland_db
OPENCLAW_DB_PORT=3306
OPENCLAW_DB_NAME=lowland_coffee
OPENCLAW_DB_USER=web251
OPENCLAW_DB_PASS=Webhk251!
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE_ME_LLM_API_KEY
LLM_MODEL=gpt-oss-120b
LLM_TIMEOUT_MS=20000
SALES_MCP_URL=http://sales-mcp:8081
# URL public cua website de OpenClaw goi bridge API khi chay standalone.
# Trong docker-compose.milestone.yml bien nay duoc override thanh http://lowland_app.
WEB_BRIDGE_BASE_URL=https://your-domain.com
WEB_BRIDGE_API_KEY=dev-bridge-key-change-me

# bank transfer info
BANK_NAME=Vietcombank
BANK_ACCOUNT_NAME=CONG TY ABC
BANK_ACCOUNT_NUMBER=0123456789
SHOP_NAME=OpenClaw Drinks

# gateway network
OPENCLAW_URL=http://openclaw:8082
HTTP_TIMEOUT_MS=20000

LOG_LEVEL=info
